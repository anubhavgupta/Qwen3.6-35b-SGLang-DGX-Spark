# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults
#
# Default (shown below): native 262K context, YaRN off, 2 concurrent
# requests. To go above 262144 (e.g. 512K or 1M), set YARN=1 and the
# desired CONTEXT_LENGTH as explained below.

# Model checkpoint (Hugging Face repo id). Default:
#   unsloth/Qwen3.6-35B-A3B-NVFP4
# e.g. unsloth/Qwen3.6-35B-A3B-NVFP4-Fast for Unsloth's faster variant.
#MODEL_ID=unsloth/Qwen3.6-35B-A3B-NVFP4

# YaRN rope scaling — REQUIRED for any context above the native 262144:
#   0 = off (the default; only valid with CONTEXT_LENGTH <= 262144)
#   1 = on  (use for e.g. 500K / 786K / 1M)
# Note: YARN implicitly turns on at exactly 1000000 even if set to 0.
# The scaling factor is derived for you:
#   factor = round(CONTEXT_LENGTH / 262144)  (must be >= 1)
#   e.g. 524288 -> 2.0, 786432 -> 3.0, 1000000 -> 4.0
#   (2.0 and 4.0 are the model card's validated values; in-between
#    factors work too but are outside the card's tested points).
YARN=0

# Context length in tokens (range 1024..1000000). Below 262144 trades
# per-request context for concurrency (e.g. 4096 x 256 requests):
#   262144  = model native (default; no rope scaling needed)
#   524288  = 512K  (needs YARN=1)
#   786432  = 768K  (needs YARN=1)
#   1000000 = 1M   (needs YARN=1; also auto-on)
CONTEXT_LENGTH=262144

# Max concurrent requests (default 2). start.sh sizes the GDN state
# pool from this value at launch (SGLang compute-mamba-ratio skill):
#   r* = S x token_equiv / L   (S=4 state slots/request, token_equiv ~3216)
#   - concurrency cap binds (or r* < 0.15): --max-mamba-cache-size =
#     MAX_CONCURRENT_REQUESTS x 4, everything else goes to KV
#   - memory binds: --mamba-full-memory-ratio r* balances both pools
#   --max-running-requests = MAX_CONCURRENT_REQUESTS either way.
# Memory note: 1 FP8 KV token ~= 10 KB; a full 1M-token request needs
# ~10 GB. start.sh warns if the budget can't fit this many requests.
MAX_CONCURRENT_REQUESTS=13

# Fraction of memory SGLang reserves for weights + state + KV (default 0.5).
#MEM_FRACTION_STATIC=0.5

# GDN pool sizing inputs (all optional):
#   MAMBA_POOL_MODE        auto (default) | pin | ratio
#   MAMBA_AVG_CONTEXT_LEN  L = avg input+output tokens/request (default CONTEXT_LENGTH)
#   MAMBA_STATE_BYTES_PER_SLOT / KV_BYTES_PER_TOKEN  per-GPU byte constants
#                          (defaults measured for this model; override with
#                          measured values from .sglang.log)
#   WEIGHTS_GIB            checkpoint size for the budget estimate (default 27.4, measured)
#   MAX_TOTAL_TOKENS       KV pool cap; default (pin mode) =
#                          MAX_CONCURRENT_REQUESTS x CONTEXT_LENGTH, e.g.
#                          2 x 262144 = 524288 tokens (~5 GiB); 0 = no cap
#MAMBA_POOL_MODE=auto
#MAMBA_AVG_CONTEXT_LEN=32768

# Server default sampling (used when a request omits a value; client values
# win). Defaults = model card "thinking mode, precise coding" profile.
# presence_penalty is fixed at SGLang's default 0.0.
#SAMPLING_TEMPERATURE=0.6
#SAMPLING_TOP_P=0.95
#SAMPLING_TOP_K=20
#SAMPLING_MIN_P=0.0
#SAMPLING_REPETITION_PENALTY=1.0

# Speculative decoding is off (no MTP/EAGLE flags are passed).

# Prefill chunk size (default 8192, the validated DGX Spark cell).
# 2048 gives smoother decode inter-token latency / better single-wave
# TTFT under mixed load, at some prefill-throughput cost.
#CHUNKED_PREFILL=8192

# Free one GDN state slot per request (S 4 -> 3) via
# SGLANG_OPT_MAMBA_SKIP_DECODE_LOCK (changes radix-lock behavior; keep 0
# unless you need the slot headroom).
#MAMBA_SKIP_DECODE_LOCK=0

# Docker CPU pinning (default: GB10's 10 Cortex-X5 cores "5-9,15-19";
# A725 efficiency cores are 0-4, 10-14). Empty string = no pinning.
#CPUSET=5-9,15-19

# Free-form extra SGLang flags, appended last (argparse last-wins lets
# them override the built-ins). The experiment hatch — e.g.:
#   EXTRA_ARGS="--enable-fused-qk-norm-rope"
#   EXTRA_ARGS="--moe-runner-backend flashinfer_cutlass"
#   EXTRA_ARGS="--fp4-gemm-runner-backend triton"
#EXTRA_ARGS=

# ./start-dflash.sh only (DFlash2 draft incoai/Qwen3.6-35B-A3B-DFlash2):
#   DF_BLOCK_SIZE      verify width / draft block (default 8, the draft's block_size)
#   DF_DRAFT_WINDOW    compact draft KV window (>= 8; draft's sliding window is 2048).
#                      Unset = draft KV costs ~12 KB/token on top of target's 10 KB.
#   DF_DRAFT_ATTN      draft attention backend (default: target's flashinfer;
#                      fa4 per model card, untested on SM121, forces BF16 draft KV)
#   DF_MAMBA_STRATEGY  extra_buffer_lazy (default) | extra_buffer
#   DRAFT_MODEL / DRAFT_REVISION  pinned draft repo / commit
# CONTEXT_LENGTH > 262144 (YaRN) is refused with a draft model.
#DF_DRAFT_WINDOW=2048

# ./start-mtp.sh only (in-checkpoint MTP head, EAGLE chain drafting):
#   MTP_STEPS / MTP_DRAFT  default 3 / 4 (topk=1 requires DRAFT = STEPS + 1)
#   MTP_EXTRA              extra flags appended after the MTP stack
#MTP_STEPS=3
#MTP_DRAFT=4
